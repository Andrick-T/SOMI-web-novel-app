generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl  = env("SHADOW_DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  username     String    @unique
  passwordHash String
  role         String    @default("READER")
  status       String    @default("ACTIVE")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?

  profile           UserProfile?
  authSessions      AuthSession[]
  books             Book[]               @relation("BookAuthor")
  wallets           Wallet?
  libraryItems      LibraryItem[]
  readings          ReadingProgress[]
  comments Comment[]
  entitlements      ChapterEntitlement[]
  transactions      WalletTransaction[]
  writerProfile     WriterProfile?
  writerSubmissions WriterSubmission[]
  writerEarnings    WriterEarning[]
  writerAssets      WriterAsset[]
}

model AuthSession {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String    @db.VarChar(128)
  expiresAt        DateTime
  revokedAt        DateTime?
  userAgent        String?   @db.VarChar(512)
  ipAddress        String?   @db.VarChar(64)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model UserProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  displayName String?
  avatar      String?
  bio         String?
  preferences Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Book {
  id            String    @id @default(uuid())
  authorId      String
  title         String
  slug          String    @unique
  synopsis      String?
  cover         String?
  heroImage     String?
  status        String    @default("DRAFT")
  rating        Float     @default(0)
  views         Int       @default(0)
  favorites     Int       @default(0)
  totalChapters Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  publishedAt   DateTime?

  author          User                 @relation("BookAuthor", fields: [authorId], references: [id])
  chapters        Chapter[]
  libraryItems    LibraryItem[]
  readingProgress ReadingProgress[]
  comments Comment[]
  entitlements    ChapterEntitlement[]
  genres          BookGenre[]
  tags            BookTag[]
  localizations   BookLocalization[]
  submissions     WriterSubmission[]
  assets          WriterAsset[]
  earnings        WriterEarning[]
}

model Chapter {
  id             String    @id @default(uuid())
  bookId         String
  number         Int
  title          String
  content        String
  wordCount      Int       @default(0)
  readingTime    Int       @default(0)
  accessType     String    @default("FREE")
  price          Int       @default(0)
  status         String    @default("DRAFT")
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  contentVersion Int       @default(0)

  book          Book                  @relation(fields: [bookId], references: [id], onDelete: Cascade)
  progress      ReadingProgress[]
  comments Comment[]
  entitlements  ChapterEntitlement[]
  localizations ChapterLocalization[]
  assets        WriterAsset[]
  submissions   WriterSubmission[]
  earnings      WriterEarning[]

  @@unique([bookId, number])
}

model Comment {
  id        String   @id @default(uuid())
  userId    String
  bookId    String
  chapterId String
  parentId  String?

  content   String   @db.Text
  gifId     String?  @db.VarChar(100)
  gifUrl    String?  @db.VarChar(1000)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  book    Book    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentReplies")

  @@index([chapterId, createdAt])
  @@index([bookId, createdAt])
  @@index([userId, createdAt])
  @@index([parentId, createdAt])
}

model Genre {
  id    String      @id @default(uuid())
  name  String      @unique
  books BookGenre[]
}

model Tag {
  id    String    @id @default(uuid())
  name  String    @unique
  books BookTag[]
}

model BookGenre {
  id      String @id @default(uuid())
  bookId  String
  genreId String

  book  Book  @relation(fields: [bookId], references: [id], onDelete: Cascade)
  genre Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@unique([bookId, genreId])
}

model BookTag {
  id     String @id @default(uuid())
  bookId String
  tagId  String

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([bookId, tagId])
}

model LibraryItem {
  id         String    @id @default(uuid())
  userId     String
  bookId     String
  status     String    @default("SAVED")
  progress   Int       @default(0)
  lastReadAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
}

model ReadingProgress {
  id                 String   @id @default(uuid())
  userId             String
  bookId             String
  chapterId          String
  progressPercentage Float    @default(0)
  position           Int      @default(0)
  lastReadAt         DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  book    Book    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId, chapterId])
}

model Wallet {
  id        String   @id @default(uuid())
  userId    String   @unique
  balance   Int      @default(0)
  currency  String   @default("SOMI")
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WalletTransaction {
  id        String   @id @default(uuid())
  userId    String
  type      String
  amount    Int
  coins     Int
  status    String   @default("PENDING")
  reference String?  @unique
  metadata  Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChapterEntitlement {
  id            String   @id @default(uuid())
  userId        String
  bookId        String
  chapterId     String
  transactionId String?
  grantedAt     DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  book    Book    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([userId, chapterId])
}

model WriterProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  displayName String?
  penName     String?
  bio         String?
  avatar      String?
  banner      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BookLocalization {
  id             String   @id @default(uuid())
  bookId         String
  languageCode   String
  title String @db.VarChar(200)
  description    String?
  status         String   @default("NOT_STARTED")
  sourceVersion  Int      @default(0)
  contentVersion Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([bookId, languageCode])
  @@index([bookId, status])
}

model ChapterLocalization {
  id             String   @id @default(uuid())
  chapterId      String
  languageCode   String
  title String @db.VarChar(200)
  content        String
  contentFormat  String   @default("plain-text")
  status         String   @default("NOT_STARTED")
  sourceVersion  Int      @default(0)
  contentVersion Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([chapterId, languageCode])
  @@index([chapterId, status])
}

model WriterSubmission {
  id              String    @id @default(uuid())
  writerId        String
  bookId          String
  chapterId       String?
  languageCode    String?
  status          String    @default("SUBMITTED")
  rejectionReason String?
  submittedAt     DateTime  @default(now())
  reviewedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  writer  User     @relation(fields: [writerId], references: [id], onDelete: Cascade)
  book    Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  chapter Chapter? @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([writerId, status])
  @@index([bookId, status])
}

model WriterAsset {
  id         String   @id @default(uuid())
  writerId   String
  bookId     String
  chapterId  String?
  storageKey String   @unique
  mimeType   String
  sizeBytes  Int
  width      Int?
  height     Int?
  altText String  @db.VarChar(500)
  caption String? @db.VarChar(500)
  status     String   @default("DRAFT")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  writer  User     @relation(fields: [writerId], references: [id], onDelete: Cascade)
  book    Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  chapter Chapter? @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([writerId, bookId])
  @@index([chapterId])
}

model WriterEarning {
  id                  String   @id @default(uuid())
  writerId            String
  bookId              String
  chapterId           String
  sourceTransactionId String   @unique
  coins               Int
  status              String   @default("PENDING")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  writer  User    @relation(fields: [writerId], references: [id], onDelete: Cascade)
  book    Book    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([writerId, status])
  @@index([bookId, chapterId])
}

model PlatformSettings {
  id                           String   @id @default(uuid())
  platformName                 String   @default("SOMI")
  supportEmail                 String   @default("support@somi.app")
  maintenanceMode              Boolean  @default(false)
  moderationEnabled            Boolean  @default(true)
  writerRegistrationEnabled    Boolean  @default(true)
  autoPublishEnabled           Boolean  @default(false)
  coinConversionRate           Float    @default(18)
  minimumPurchase              Int      @default(100)
  chapterPricingRules          String   @default("premium chapters require explicit pricing")
  emailNotifications           Boolean  @default(true)
  moderationNotifications      Boolean  @default(true)
  paymentNotifications         Boolean  @default(true)
  sessionPolicy                String   @default("JWT")
  adminSessionTimeoutMinutes   Int      @default(60)
  suspiciousActivityMonitoring Boolean  @default(true)
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt
}

model AuditEvent {
  id         String   @id @default(uuid())
  actorId    String?
  actorName  String?
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
}
